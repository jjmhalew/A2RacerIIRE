// a2racerre.rc - the icon and version information of A2RacerIIRE.exe (build.bat). ProductVersion is the release version:
// a release tag v1.2.3 must match it (.github/workflows/build.yml), and the Android build reads it too.
1 ICON "a2racerre.ico"

1 VERSIONINFO
FILEVERSION 0,9,0,0
PRODUCTVERSION 0,9,0,0
FILEOS 0x40004
FILETYPE 1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "A2RacerIIRE contributors"
      VALUE "FileDescription", "A2RacerIIRE - engine reimplementation of A2 Racer II"
      VALUE "FileVersion", "0.9.0"
      VALUE "InternalName", "A2RacerIIRE"
      VALUE "LegalCopyright", "GNU GPL v3 or later. A2 Racer II is a trademark of its owners."
      VALUE "OriginalFilename", "A2RacerIIRE.exe"
      VALUE "ProductName", "A2RacerIIRE"
      VALUE "ProductVersion", "0.9.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
